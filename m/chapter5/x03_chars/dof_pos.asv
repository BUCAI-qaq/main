clc; clear; close all;

%% ============== 字体设置 ==============
fontCN = 'SimSun';           
fontEN = 'Times New Roman';  
fs = 16;   % ⭐ 改为16

%% =========================
% 1. 文件路径
%% =========================
real_file = 'realdata_2025-12-10_14-40-47.txt';
sim_file  = 'simdata_2026-03-20_15-04-37.txt';

%% =========================
% 2. 读取数据
%% =========================
real_tbl = readtable(real_file, 'FileType', 'text', 'VariableNamingRule', 'preserve');
sim_tbl  = readtable(sim_file,  'FileType', 'text', 'VariableNamingRule', 'preserve');

t_real = real_tbl.time;
t_sim  = sim_tbl.time;

%% =========================
% 3. 时间区间裁剪
%% =========================
t_min = 1;
t_max = 11;

idx_real = (t_real >= t_min) & (t_real <= t_max);
idx_sim  = (t_sim  >= t_min) & (t_sim  <= t_max);

real_tbl = real_tbl(idx_real, :);
sim_tbl  = sim_tbl(idx_sim, :);

t_real = real_tbl.time;
t_sim  = sim_tbl.time;

%% =========================
% 4. 绘图参数
%% =========================
lw_angle = 1.8;

%% =========================
% 5. 关键关节
%% =========================
joint_info = {
    'Left Hip Pitch',      'jpLt',  'jpLc';
    'Left Knee',           'jkLt',  'jkLc';
    'Left Ankle Pitch',    'japLt', 'japLc';
    'Left Shoulder Pitch', 'jspLt', 'jspLc';
    'Left Elbow',          'jeLt',  'jeLc';
};

for i = 1:size(joint_info,1)

    ang_t = real_tbl.(joint_info{i,2});
    ang_c = real_tbl.(joint_info{i,3});

    figure('Color', 'w');

    plot(t_real, ang_t, '--', 'Color', [0 0.4470 0.7410], 'LineWidth', lw_angle); hold on;
    plot(t_real, ang_c, '-',  'Color', [0.8500 0.3250 0.0980], 'LineWidth', lw_angle);

    grid on;

    %% ===== X轴 =====
    xlabel(['\fontname{',fontCN,'}时间 ', ...
            '\fontname{',fontEN,'}(s)'], ...
            'FontSize', fs, 'Interpreter','tex');

    %% ===== Y轴 =====
    ylabel(['\fontname{',fontCN,'}关节角度 ', ...
            '\fontname{',fontEN,'}(rad)'], ...
            'FontSize', fs, 'Interpreter','tex');

    %% ===== legend（中文宋体）=====
    lgd = legend({ ...
        ['\fontname{',fontCN,'}期望角度'], ...
        ['\fontname{',fontCN,'}实际角度']}, ...
        'Interpreter','tex', ...
        'FontSize', fs);

    set(lgd, 'Units', 'normalized', 'Position', [0.705, 0.825, 0.2, 0.1]);

    %% ===== 坐标轴刻度 =====
    set(gca, ...
        'FontName', fontEN, ...
        'FontSize', fs, ...
        'LineWidth', 1.0);

end

%% =========================
% 6. RPY
%% =========================
r = sim_tbl.r;
p = sim_tbl.p;
y = sim_tbl.y;

figure('Color', 'w');

plot(t_sim, r, 'LineWidth', 1.8); hold on;
plot(t_sim, p, '--', 'LineWidth', 1.8);
plot(t_sim, y, '-.', 'LineWidth', 1.8);

grid on;

%% ===== X轴 =====
xlabel(['\fontname{',fontCN,'}时间 ', ...
        '\fontname{',fontEN,'}(s)'], ...
        'FontSize', fs, 'Interpreter','tex');

%% ===== Y轴 =====
ylabel(['\fontname{',fontCN,'}角度 ', ...
        '\fontname{',fontEN,'}(rad)'], ...
        'FontSize', fs, 'Interpreter','tex');

%% ===== legend =====
lgd = legend({ ...
    ['\fontname{',fontCN,'}横滚角'], ...
    ['\fontname{',fontCN,'}俯仰角'], ...
    ['\fontname{',fontCN,'}航向角']}, ...
    'Interpreter','tex', ...
    'FontSize', fs);

set(lgd, 'Units', 'normalized', 'Position', [0.705, 0.825, 0.2, 0.1]);

%% 坐标轴刻度
set(gca, ...
    'FontName', fontEN, ...
    'FontSize', fs);